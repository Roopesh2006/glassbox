# GlassBox requires ZERO API keys and ZERO external services!
# Optional runtime configuration:

# Default policy preset: balanced | strict | audit | /path/to/custom-policy.json
GLASSBOX_POLICY=balanced

# Port for the local interactive Web Flight Recorder UI (`glassbox ui`)
GLASSBOX_PORT=8765

# Optional: disable ANSI color output in CLI
# NO_COLOR=1
